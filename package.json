  "keywords": [
    "agent",
    "bun",
    "chatgpt",
    "cli",
    "computer-history",
    "image-generation",
    "pages",
    "sites"
  ],
  "homepage": "https://github.com/yuki-yano/codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/yuki-yano/codex-bridge/issues"
  },
  "license": "MIT",
  "author": "Yuki Yano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuki-yano/codex-bridge.git"
  },
  "bin": {
    "codex-bridge": "src/cli.ts"
  },
  "files": [
    "src",
    "skills"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
